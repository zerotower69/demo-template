  "description": "nestjs microservice for my web site",
  "keywords": [],
  "scripts": {
    "copy-proto": "cp  -r proto dist/proto",
    "start:gateway:prod": "cross-env NODE_ENV=prod node ./dist/apps/gateway/main.js",
    "start:oauth:prod": "cross-env NODE_ENV=prod node ./dist/apps/oauth/main.js",
    "start-all:prod": "npm-run-all -p --print-label start:gateway:prod  start:oauth:prod",
    "start:gateway:dev": "cross-env NODE_ENV=dev node ./dist/apps/gateway/main.js",
    "start:oauth:dev": "cross-env NODE_ENV=dev node ./dist/apps/oauth/main.js",
    "start-all:dev": "npm-run-all -p --print-label start:gateway:dev  start:oauth:dev"
  },
  "author": {
